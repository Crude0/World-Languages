// macOS'ta gerçek bir uygulama penceresi: NSWindow + WKWebView.
// osascript -l JavaScript atlas.jxa <html-yolu> [icns-yolu] [sürüm]
// Herhangi bir hata olursa betik çıkış kodu 1 ile biter; başlatıcı o zaman
// tarayıcı kipine düşer.
ObjC.import('Cocoa');
ObjC.import('WebKit');

var TITLE = 'Dünya Dilleri Atlası';
var COPY = '© 2026 Crude · Açık veri · Natural Earth sınırları';
var keep = [];   // çöp toplayıcıdan korunacak nesneler
var web = null;  // menüden sayfaya komut göndermek için
var appIcon = null;  // Hakkında penceresi de bunu kullanıyor
var saverStatus = 'kurulmadı';  // dosya kaydetme köprüsünün durumu

function run(argv) {
  var htmlPath = argv[0];
  var iconPath = argv.length > 1 ? argv[1] : '';
  var version = argv.length > 2 ? argv[2] : '';

  // Uygulama menüsünün başlığı NSMenuItem'dan değil, çalışan sürecin paket
  // adından gelir. Betik osascript'in içinde koştuğu için macOS menüye
  // "osascript" yazıyordu. Paket sözlüğündeki adı değiştirmek bunu düzeltir;
  // sözlük değiştirilemezse menü eski adıyla açılır, uygulama yine çalışır.
  try {
    var info = $.NSBundle.mainBundle.infoDictionary;
    info.setValueForKey($(TITLE), $('CFBundleName'));
    info.setValueForKey($(TITLE), $('CFBundleDisplayName'));
  } catch (e) {}
  try { $.NSProcessInfo.processInfo.setProcessName(TITLE); } catch (e) {}

  var app = $.NSApplication.sharedApplication;
  app.setActivationPolicy(0);              // NSApplicationActivationPolicyRegular

  if (iconPath) {
    var img = $.NSImage.alloc.initWithContentsOfFile(iconPath);
    if (!img.isNil()) {
      app.applicationIconImage = img;
      appIcon = img;
      keep.push(img);
    }
  }

  var rect = $.NSMakeRect(0, 0, 1440, 940);
  var win = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(
    rect, 15 /* Titled|Closable|Miniaturizable|Resizable */, 2 /* Buffered */, false);
  win.title = TITLE;
  win.setMinSize($.NSMakeSize(720, 520));
  win.center;
  keep.push(win);

  var cfg = $.WKWebViewConfiguration.alloc.init;
  saverStatus = installSaver(cfg);
  web = $.WKWebView.alloc.initWithFrameConfiguration(rect, cfg);
  var url = $.NSURL.fileURLWithPath(htmlPath);
  web.loadFileURLAllowingReadAccessToURL(url, url.URLByDeletingLastPathComponent);
  win.contentView = web;
  keep.push(web);

  var actions = makeActions(version);
  buildMenu(app, actions);

  // Denetim kipi: menüyü kurup yazdır ve çık. Mac olmadan geliştirildiği
  // için yayım iş akışı bunu macOS koşucusunda çalıştırıp menü adlarının
  // doğru çıktığını doğruluyor (bkz. .github/workflows/release.yml).
  if (argv.length > 3 && argv[3] === 'dump') {
    var out = [];
    var bar = app.mainMenu;
    for (var i = 0; i < bar.numberOfItems; i++) {
      var top = bar.itemAtIndex(i);
      var sub = top.submenu;
      var kids = [];
      for (var j = 0; j < sub.numberOfItems; j++) {
        var t = ObjC.unwrap(sub.itemAtIndex(j).title);
        kids.push(sub.itemAtIndex(j).isSeparatorItem ? '---' : t);
      }
      // İlk menünün başlığını macOS paket adından yazar; gerçekte
      // görünen ad bu, NSMenu'nunki değil.
      out.push((i === 0 ? '[uygulama menüsü] ' : '') +
               ObjC.unwrap(sub.title) + ': ' + kids.join(' | '));
    }
    out.push('paket adı: ' + ObjC.unwrap(
      $.NSBundle.mainBundle.objectForInfoDictionaryKey('CFBundleName')));
    out.push('süreç adı: ' + ObjC.unwrap($.NSProcessInfo.processInfo.processName));
    var ab = aboutOptions(version);
    var icon = ab.objectForKey($('ApplicationIcon'));
    out.push('hakkında telif: ' + ObjC.unwrap(ab.objectForKey($('Copyright'))));
    out.push('hakkında sürüm: ' + ObjC.unwrap(ab.objectForKey($('ApplicationVersion'))));
    out.push('hakkında simge: ' + (!icon || icon.isNil() ? 'yok'
      : Math.round(icon.size.width) + 'x' + Math.round(icon.size.height)));
    // Kaydetme köprüsü Mac olmadan yazıldı; burada gerçekten kuruluyor mu ve
    // yazma yolu işliyor mu, ikisi de gerçek macOS'ta ölçülüyor. Yayım iş
    // akışı bu iki satırı arıyor (bkz. .github/workflows/release.yml).
    out.push('köprü: ' + saverStatus);
    var probe = 'atlas-denetim-' + Math.round(Math.random() * 1e9) + '.txt';
    var wrote = writeDownload(probe, 'YXRsYXM=');   // "atlas"
    var probePath = ObjC.unwrap($.NSHomeDirectory()) + '/Downloads/' + probe;
    var seen = $.NSFileManager.defaultManager.fileExistsAtPath($(probePath));
    if (seen) { $.NSFileManager.defaultManager.removeItemAtPathError($(probePath), null); }
    out.push('kaydetme denemesi: ' + (wrote && seen ? 'ok' : 'BAŞARISIZ'));
    $.NSFileHandle.fileHandleWithStandardOutput.writeData(
      $(out.join('\n') + '\n').dataUsingEncoding($.NSUTF8StringEncoding));
    return;
  }

  // pencere kapatılınca uygulamadan da çık
  try {
    ObjC.registerSubclass({
      name: 'AtlasWindowDelegate',
      superclass: 'NSObject',
      methods: {
        'windowWillClose:': {
          types: ['void', ['id']],
          implementation: function (n) { $.NSApp.terminate(null); }
        }
      }
    });
    var del = $.AtlasWindowDelegate.alloc.init;
    keep.push(del);
    win.delegate = del;
  } catch (e) { /* delege kurulamazsa pencere yine açılır */ }

  app.activateIgnoringOtherApps(true);
  win.makeKeyAndOrderFront(null);
  app.run;
}

// --- dosya kaydetme köprüsü -------------------------------------------------
// WKWebView'in bir indirme işleyicisi yok: sayfadaki <a download> tıklaması
// sessizce yutuluyor, PNG/SVG dışa aktarma hiçbir yere dosya bırakmıyordu.
// Sayfa baytları base64 olarak yolluyor, burada ~/Downloads'a yazılıyor.

// Yazma işi köprüden ayrı bir işlev: denetim kipi bunu doğrudan çağırıp
// gerçek bir Mac'te yolun işlediğini kanıtlıyor.
function writeDownload(name, b64) {
  try {
    if (!name || !b64) { return false; }
    var data = $.NSData.alloc.initWithBase64EncodedStringOptions($(String(b64)), 0);
    if (!data || data.isNil()) { return false; }
    // Ad sayfadan geliyor; hedef klasörün dışına çıkmasın.
    var safe = String(name).replace(/[\/\\:]/g, '-');
    if (!safe || safe === '.' || safe === '..') { return false; }
    var dir = ObjC.unwrap($.NSHomeDirectory()) + '/Downloads';
    $.NSFileManager.defaultManager
      .createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
        $(dir), true, $(), null);
    return !!data.writeToFileAtomically($(dir + '/' + safe), true);
  } catch (e) {
    return false;
  }
}

// Köprüyü kurar ve durumunu döndürür. Hata yutulmuyor: denetim kipi ve
// yayım iş akışı bu dizgeyi okuyor, böylece köprü bir daha sessizce
// kurulmamış olamaz.
function installSaver(cfg) {
  try {
    // protocols anahtarı bilerek verilmiyor: WebKit yöntemi doğrudan
    // çağırıyor, protokol bildirimi bir şey eklemiyor ve JXA'da kimi
    // sürümlerde kurulumu tümden düşürüyor.
    if (!$.AtlasSaver) {
      ObjC.registerSubclass({
        name: 'AtlasSaver',
        superclass: 'NSObject',
        methods: {
          'userContentController:didReceiveScriptMessage:': {
            types: ['void', ['id', 'id']],
            implementation: function (_ucc, msg) {
              var ok = false;
              try {
                var body = msg.body;
                ok = writeDownload(ObjC.unwrap(body.objectForKey($('name'))),
                                   ObjC.unwrap(body.objectForKey($('b64'))));
              } catch (e) { ok = false; }
              // Geri bildirim başarısız olsa bile dosya yazılmış olur.
              try {
                if (web) {
                  web.evaluateJavaScriptCompletionHandler(
                    $('window.__atlasSaved && window.__atlasSaved(' +
                      (ok ? 'true' : 'false') + ')'), $());
                }
              } catch (e) {}
            }
          }
        }
      });
    }
    var saver = $.AtlasSaver.alloc.init;
    if (!saver || saver.isNil()) { return 'HATA: AtlasSaver kurulamadı'; }
    keep.push(saver);
    var ucc = cfg.userContentController;
    if (!ucc || ucc.isNil()) { return 'HATA: userContentController yok'; }
    ucc.addScriptMessageHandlerName(saver, $('atlasSave'));
    return 'ok';
  } catch (e) {
    return 'HATA: ' + (e && e.message ? e.message : String(e));
  }
}

// "Hakkında" penceresinin seçenekleri. Denetim kipi de bunu okuyor, yani
// yayım iş akışı gerçek macOS'ta değerleri doğruluyor.
function aboutOptions(version) {
  var d = $.NSMutableDictionary.alloc.init;
  d.setObjectForKey($(TITLE), $('ApplicationName'));
  d.setObjectForKey($(version || ''), $('ApplicationVersion'));
  // Standart pencere sürümün yanına parantez içinde derleme numarasını
  // yazar; osascript'in içinde koştuğumuz için oraya onun numarası ("410")
  // düşüyordu. Boş verince parantez hiç çıkmıyor.
  d.setObjectForKey($(''), $('Version'));
  d.setObjectForKey($(COPY), $('Copyright'));
  // Simgeyi de açıkça veriyoruz: yoksa pencere paketin simgesini arıyor ve
  // osascript'inkini (genel klasör görüntüsü) buluyor.
  if (appIcon) d.setObjectForKey(appIcon, $('ApplicationIcon'));
  return d;
}

// Menüden sayfaya köprü. Yakınlaştırma ve sığdırma sayfanın kendi
// düğmelerini tetikler, böylece menü ile araç çubuğu aynı işi yapar.
function makeActions(version) {
  function js(code) {
    if (web) { try { web.evaluateJavaScriptCompletionHandler(code, $()); } catch (e) {} }
  }
  try {
    ObjC.registerSubclass({
      name: 'AtlasActions',
      superclass: 'NSObject',
      methods: {
        'about:': {
          types: ['void', ['id']],
          implementation: function () {
            $.NSApp.orderFrontStandardAboutPanelWithOptions(aboutOptions(version));
          }
        },
        'quitApp:': {
          types: ['void', ['id']],
          implementation: function () { $.NSApp.terminate(null); }
        },
        'zoomIn:': {
          types: ['void', ['id']],
          implementation: function () { js('document.getElementById("btnIn").click()'); }
        },
        'zoomOut:': {
          types: ['void', ['id']],
          implementation: function () { js('document.getElementById("btnOut").click()'); }
        },
        'zoomFit:': {
          types: ['void', ['id']],
          implementation: function () { js('document.getElementById("btnFit").click()'); }
        },
        'toggleTable:': {
          types: ['void', ['id']],
          implementation: function () { js('document.getElementById("btnTable").click()'); }
        },
        'copyLink:': {
          types: ['void', ['id']],
          implementation: function () { js('document.getElementById("btnLink").click()'); }
        },
        // Pencerenin tam ekranı değil, sayfanın kendi harita kipi: başlık,
        // kenar çubuğu ve kartlar da kalkıyor, geriye yalnız harita kalıyor.
        'mapFull:': {
          types: ['void', ['id']],
          implementation: function () { js('document.getElementById("btnFull").click()'); }
        }
      }
    });
  } catch (e) { return null; }
  var a = $.AtlasActions.alloc.init;
  keep.push(a);
  return a;
}

function buildMenu(app, actions) {
  var bar = $.NSMenu.alloc.init;
  keep.push(bar);

  // [başlık, seçici, kısayol, hedef]  ·  null satır = ayırıcı,
  // hedef 'fr' = ilk yanıtlayıcı (metin alanı, pencere).
  // Sistemin kendi yazdığı başlıklardan kaçınmak için Çık kendi
  // seçicimizi kullanıyor: `terminate:` olsaydı macOS başlığı
  // "Quit and Keep Windows" diye değiştiriyordu (üstelik İngilizce,
  // çünkü çalışan paket osascript'in yerelleştirmesini taşıyor).
  add(TITLE, [
    [TITLE + ' Hakkında', 'about:', '', actions],
    null,
    ['Gizle', 'hide:', 'h', app],
    ['Diğerlerini Gizle', 'hideOtherApplications:', '', app],
    ['Tümünü Göster', 'unhideAllApplications:', '', app],
    null,
    ['Çık', actions ? 'quitApp:' : 'terminate:', 'q', actions || app],
  ]);
  add('Dosya', [
    ['Bağlantıyı Kopyala', 'copyLink:', 'l', actions],
    null,
    ['Pencereyi Kapat', 'performClose:', 'w', 'fr'],
  ]);
  add('Düzen', [
    ['Geri Al', 'undo:', 'z', 'fr'],
    ['Yinele', 'redo:', 'Z', 'fr'],
    null,
    ['Kes', 'cut:', 'x', 'fr'],
    ['Kopyala', 'copy:', 'c', 'fr'],
    ['Yapıştır', 'paste:', 'v', 'fr'],
    ['Tümünü Seç', 'selectAll:', 'a', 'fr'],
  ]);
  add('Görünüm', [
    ['Yakınlaş', 'zoomIn:', '+', actions],
    ['Uzaklaş', 'zoomOut:', '-', actions],
    ['Haritayı Sığdır', 'zoomFit:', '0', actions],
    null,
    ['Tabloyu Aç/Kapat', 'toggleTable:', 't', actions],
    null,
    ['Yalnız Harita', 'mapFull:', 'F', actions],
    ['Tam Ekran', 'toggleFullScreen:', 'f', 'fr'],
  ]);
  add('Pencere', [
    ['Küçült', 'miniaturize:', 'm', 'fr'],
    ['Yakınlaştır', 'zoom:', '', 'fr'],
    null,
    ['Kapat', 'performClose:', 'w', 'fr'],
  ]);
  app.mainMenu = bar;

  function add(name, items) {
    var top = $.NSMenuItem.alloc.init;
    var menu = $.NSMenu.alloc.initWithTitle(name);
    for (var i = 0; i < items.length; i++) {
      var it = items[i];
      if (it === null) { menu.addItem($.NSMenuItem.separatorItem); continue; }
      if (!it[3]) continue;                       // eylemi kurulamadıysa atla
      var mi = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent(
        it[0], $.NSSelectorFromString(it[1]), it[2]);
      if (it[3] !== 'fr') mi.setTarget(it[3]);    // 'fr' = ilk yanıtlayıcı
      menu.addItem(mi);
    }
    top.setSubmenu(menu);
    bar.addItem(top);
    keep.push(menu);
  }
}
